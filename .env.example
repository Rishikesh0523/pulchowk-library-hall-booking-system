# Root environment file used by docker-compose
# Copy to .env and edit values
DB_NAME=library_booking
DB_USER=postgres
DB_PASSWORD=postgres

JWT_SECRET=please-change-this-to-a-strong-random-string
JWT_EXPIRES_IN=24h

ADMIN_EMAIL=admin@library.com
ADMIN_PASSWORD=admin123

CORS_ORIGIN=http://localhost:5173

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Production image names (used by docker-compose.prod.yml)
BACKEND_IMAGE=library-booking-backend:latest
FRONTEND_IMAGE=library-booking-frontend:latest
