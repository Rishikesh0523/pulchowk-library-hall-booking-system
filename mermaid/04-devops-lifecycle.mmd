%% End-to-end DevOps Lifecycle
%% Code change → tested → built → provisioned → deployed → monitored.

flowchart LR
    Dev([Developer<br/>laptop])

    subgraph Local["Local Development"]
        D1[Edit code]
        D2[docker compose up --build]
        D3[Run on localhost:5173]
        D1 --> D2 --> D3
    end

    subgraph CI["Continuous Integration"]
        C1[GitHub<br/>push to main]
        C2[GitHub Actions:<br/>lint · test · build]
        C3[(GHCR<br/>tagged images)]
        C1 --> C2 --> C3
    end

    subgraph Provision["Provisioning · OpenTofu/Terraform"]
        T1[tofu init]
        T2[tofu plan]
        T3[tofu apply]
        T4[EC2 + SG ready,<br/>Docker pre-installed]
        T1 --> T2 --> T3 --> T4
    end

    subgraph Deploy["Configuration · Ansible"]
        A1[ansible-playbook deploy.yml]
        A2[rsync local code → EC2]
        A3[copy prod.env]
        A4[docker compose up -d --build]
        A1 --> A2 --> A3 --> A4
    end

    subgraph Run["Production"]
        R1[Live app<br/>http://&lt;public_ip&gt;]
        R2[Prometheus<br/>scrapes /metrics]
        R3[Grafana<br/>dashboard]
        R1 --> R2 --> R3
    end

    Dev --> Local
    Local -->|git push| CI
    CI -.optional pull at deploy.-> Deploy
    Dev --> Provision
    Provision --> Deploy
    Deploy --> Run
    Run -. observe .-> Dev

    classDef step fill:#f8fafc,stroke:#0f172a,stroke-width:1px;
    classDef phase fill:#eef2ff,stroke:#3730a3,stroke-width:1px;
    class D1,D2,D3,C1,C2,C3,T1,T2,T3,T4,A1,A2,A3,A4,R1,R2,R3 step;
