%% Request flow — how a browser hit reaches the database
%% Same path applies for both dev (compose) and prod (EC2).

flowchart LR
    Browser([Browser]) -->|HTTPS/HTTP<br/>GET /rooms| EdgeNginx
    Browser -->|XHR<br/>GET /api/rooms| EdgeNginx

    subgraph Frontend["Frontend container"]
        EdgeNginx[Nginx<br/>static + reverse proxy]
        Static[/dist/index.html<br/>/dist/assets/*.js .css/]
        EdgeNginx -->|static asset| Static
    end

    subgraph Backend["Backend container"]
        Helmet[Helmet]
        CORS[CORS]
        Limiter[rate-limit<br/>200/min/IP]
        Metrics[metrics middleware]
        Router[Express Router]
        AuthMw[authenticate]
        AdminMw[requireAdmin]
        Ctrl[Controller]
        Model[Model<br/>parameterized SQL]
        Helmet --> CORS --> Limiter --> Metrics --> Router --> AuthMw --> AdminMw --> Ctrl --> Model
    end

    EdgeNginx -->|/api/* proxy_pass| Helmet
    Model -->|pg pool| DB[(PostgreSQL)]
    DB --> Model --> Ctrl --> Browser

    Prom[Prometheus] -. /metrics .-> Metrics

    classDef mw fill:#fef9c3,stroke:#92400e,color:#92400e;
    classDef ctrl fill:#dcfce7,stroke:#166534,color:#166534;
    classDef db fill:#dbeafe,stroke:#1e40af,color:#1e40af;
    class Helmet,CORS,Limiter,Metrics,Router,AuthMw,AdminMw mw;
    class Ctrl,Model ctrl;
    class DB db;
